# App
APP_ENV=development            # production hides /docs and changes log behaviour
APP_NAME=ServerAlly
APP_VERSION=1.0.0
SECRET_KEY=                     # python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=                 # python -c "import secrets; print(secrets.token_hex(32))"  (NEVER rotate after data exists)

# Background scheduler — keep true on exactly ONE backend process
ENABLE_SCHEDULER=true

# Error monitoring (optional) — leave blank to disable Sentry
SENTRY_DSN=

# Database
DATABASE_URL=postgresql+asyncpg://servermind:password@localhost:5432/servermind
POSTGRES_USER=servermind
POSTGRES_PASSWORD=password
POSTGRES_DB=servermind

# Redis
REDIS_URL=redis://localhost:6379/0

# AI provider (multi-provider — bring your own key)
#   AI_PROVIDER: anthropic | openai | gemini | openai_compatible
#   Leave AI_API_KEY / AI_MODEL blank to fall back to the ANTHROPIC_* values (default).
#   AI_BASE_URL: only for openai_compatible / self-hosted endpoints.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Hosted "ServerAlly AI" subscription gateway (used when AI_PROVIDER=servermind;
# AI_API_KEY is then the subscription token). See gateway/ + docs.
AI_GATEWAY_URL=https://ai.serverally.app/v1

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — set to your production domain(s), e.g. https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@serverally.ai

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=serverally-logs

# Frontend (build-time — baked into the bundle)
# Dev: point at the local backend. Prod: use your HTTPS/WSS domain.
#   VITE_API_URL=https://app.example.com
#   VITE_WS_URL=wss://app.example.com
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=ServerAlly
VITE_APP_TAGLINE=Your AI companion to manage, automate, and secure any server — without the expertise.

# Billing entitlement API (docs/WHMCS-INTEGRATION.md) — empty disables it
ENTITLEMENT_API_KEY=

# Remote Desktop (Assets Phase E) — the guacd streaming service for the live
# in-browser Windows desktop. Empty = viewer says "streaming not set up". In Docker
# (compose): guacd:4822. Local dev: 127.0.0.1:4822.
RDP_GUACD_URL=
